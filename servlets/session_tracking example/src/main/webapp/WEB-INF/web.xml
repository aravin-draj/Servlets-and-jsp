<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
    <servlet>
        <servlet-name>example.LoginServlet</servlet-name>
        <servlet-class>example.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>example.LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>example.DashboardServlet</servlet-name>
        <servlet-class>example.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>example.DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>example.LogoutServlet</servlet-name>
        <servlet-class>example.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>example.LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
</web-app>
